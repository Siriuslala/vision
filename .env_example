# Copy this file to .env and fill in your local absolute paths.
# .env is private and ignored by Git; .env_example can be committed.
# Use literal absolute paths in double quotes (spaces are supported).
# Do not use shell commands, variable references or ~ in these paths.

ROOT_DIR=""  # Code: absolute path to this repository (contains pyproject.toml).
DATA_DIR=""  # Data: parent directory of BabyVision/; also the export destination.
WORK_DIR=""  # Outputs: generation results, checkpoints, etc.; preferably outside this repository.

# Optional: Hugging Face hub cache containing models--*/datasets--*.
# Empty uses the standard HF_HUB_CACHE/HF_HOME/default cache convention.
HF_HUB_CACHE=""
