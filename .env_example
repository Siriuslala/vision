# Copy this file to .env and fill in your local absolute paths.
# .env is private and ignored by Git; .env_example can be committed.
# Use literal absolute paths in double quotes (spaces are supported).
# Do not use shell commands, variable references or ~ in these paths.

ROOT_DIR=""  # Code: absolute path to this repository (contains pyproject.toml).
DATA_DIR=""  # Data: parent directory of BabyVision/; also the export destination.
WORK_DIR=""  # Outputs: generation results, checkpoints, etc.; preferably outside this repository.

# Optional: Hugging Face hub cache containing models--*/datasets--*.
# Empty uses the standard HF_HUB_CACHE/HF_HOME/default cache convention.
HF_HUB_CACHE=""

# Optional: local RefCOCO dataset root containing data/*.parquet.
REFCOCO_DIR=""

# Optional: Unicode font file with CJK coverage for token-map PNGs.
TOKEN_MAP_FONT=""

# Optional network settings for Bash entry points. Uncomment and supply nonempty URLs.
# Inherited endpoint/proxy variables are used when these settings are omitted.
# HF_ENDPOINT="https://huggingface.co"
# http_proxy="http://proxy.example.org:8080"
# https_proxy="http://proxy.example.org:8080"

# Shared source dataset root; required by scripts/download.sh.
# SFT production falls back to DATA_DIR when this setting is omitted.
# DATA_DIR_PUBLIC=""

# Optional local SAM3 Tracker checkpoint for offline point annotation.
# SAM3_CHECKPOINT=""
